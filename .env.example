# PostgreSQL — use 5433 from host, 5432 within Docker network
PGHOST=localhost
PGPORT=5433
PGDATABASE=ragdb
PGUSER=raguser
PGPASSWORD=<change-me>
PGPOOL_MIN_SIZE=2
PGPOOL_MAX_SIZE=5

# LLM provider endpoint (OpenAI-compatible)
OPENAI_API_KEY=<your-key>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Search tuning
HNSW_EF_SEARCH=400

# GitHub PAT (repo:read scope — for fetching source code)
GITHUB_TOKEN=<your-github-pat>

# Ingest (set by docker-compose, override locally)
SUMMARIES_FILE=./code-summarisation-agent/temp/summaries.json
GITHUB_SOURCE=sample-service
